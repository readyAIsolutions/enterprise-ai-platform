# =============================================================================
# ENI Enterprise Platform — .dockerignore
# Patterns excluded from Docker build context for lean images & fast builds
# =============================================================================

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so
*.egg-info/
*.egg
*.whl
.eggs/
dist/
build/
develop-eggs/
parts/
sdist/
*.manifest
*.spec

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
.venv*
*virtualenv*

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.DS_Store

# ── Testing & Coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.coverage
coverage.xml
junit.xml
.tox/
.nox/
*.log
report.html

# ── Type checking & Linting ──────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ── Git ────────────────────────────────────────────────────────────────────────
.git/
.gitignore
.github/
.gitattributes
.gitmodules

# ── Docker artifacts ─────────────────────────────────────────────────────────
.dockerignore
Dockerfile*
docker-compose*.yml
docker/docker-compose*.yml

# ── Enterprise validation reports (large) ────────────────────────────────────
Enterprise_Validation/

# ── Documentation ─────────────────────────────────────────────────────────────
docs/
*.md
README*
CHANGELOG*
LICENSE*

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
.envrc
secrets/
*.pem
*.key
*.cert
credentials*

# ── Monitoring data ──────────────────────────────────────────────────────────
monitoring/prometheus.yml
monitoring/grafana/
prometheus_data/
grafana_data/

# ── OS junk ────────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Node (if any dashboard frontend) ─────────────────────────────────────────
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temp & Cache ──────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
cache/
.cache/